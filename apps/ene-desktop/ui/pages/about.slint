import { UiState } from "../state/ui-state.slint";
import { BodyText, HintText, SectionTitle } from "../widgets/typography.slint";
import { AboutSlint, Palette, ScrollView } from "std-widgets.slint";

export component AboutView inherits Rectangle {
    in property <bool> active;
    body := ScrollView {
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        content := VerticalLayout {
            alignment: start;
            spacing: 16px;
            padding-right: 12px;
            SectionTitle { text: "eneについて"; font-size: 22px * UiState.scale; }
            BodyText { text: "バージョン " + UiState.app-version; }
            SectionTitle { text: "クレジット"; }
            // AboutSlint fills its parent and makes the whole area clickable.
            // Keep that parent fixed; neither the row nor its whitespace is a link.
            credit := Rectangle {
                min-width: 200px; max-width: 200px;
                min-height: 112px; max-height: 112px;
                horizontal-stretch: 0; vertical-stretch: 0;
                clip: true;
                border-radius: 4px;
                border-width: link-focus.has-focus ? 2px : 0px;
                border-color: Palette.accent-background;
                background: pointer.has-hover && root.active ? Palette.alternate-background : transparent;
                accessible-role: button;
                accessible-label: "SlintのWebサイト";
                accessible-enabled: root.active;
                accessible-action-default => { if root.active { Platform.open-url("https://slint.dev"); } }
                AboutSlint { width: parent.width; height: parent.height; }
                pointer := TouchArea {
                    enabled: root.active;
                    clicked => { link-focus.focus(); Platform.open-url("https://slint.dev"); }
                }
                link-focus := FocusScope {
                    width: 0px; height: 0px;
                    enabled: root.active;
                    key-pressed(event) => {
                        if event.text == Key.Return || event.text == Key.Space {
                            if !event.repeat { Platform.open-url("https://slint.dev"); }
                            return accept;
                        }
                        return reject;
                    }
                    changed has-focus => {
                        if self.has-focus {
                            if credit.absolute-position.y < body.absolute-position.y {
                                body.content-y = min(0px, body.content-y + body.absolute-position.y - credit.absolute-position.y);
                            } else if credit.absolute-position.y + credit.height > body.absolute-position.y + body.visible-height {
                                body.content-y = max(min(0px, body.visible-height - body.content-height), body.content-y - (credit.absolute-position.y + credit.height - body.absolute-position.y - body.visible-height));
                            }
                        }
                    }
                }
            }
            BodyText { text: "アイコン: Lucide"; }
            SectionTitle { text: "動作状況"; }
            HintText { text: UiState.tray-status; }
        }
    }
}
