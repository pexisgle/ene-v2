import { Button, Palette } from "std-widgets.slint";

// Embedded vectors share one stroke style and follow the active palette.
export global Icons {
    out property <image> settings: @image-url("../assets/icons/settings.svg");
    out property <image> send: @image-url("../assets/icons/send.svg");
    out property <image> folder: @image-url("../assets/icons/folder.svg");
    out property <image> avatar: @image-url("../assets/icons/avatar.svg");
    out property <image> motion: @image-url("../assets/icons/motion.svg");
    out property <image> reset: @image-url("../assets/icons/reset.svg");
    out property <image> center: @image-url("../assets/icons/center.svg");
    out property <image> refresh: @image-url("../assets/icons/refresh.svg");
    out property <image> exit: @image-url("../assets/icons/exit.svg");
    out property <image> save: @image-url("../assets/icons/save.svg");
    out property <image> chat: @image-url("../assets/icons/chat.svg");
    out property <image> desktop: @image-url("../assets/icons/desktop.svg");
    out property <image> shield: @image-url("../assets/icons/shield.svg");
    out property <image> connection: @image-url("../assets/icons/connection.svg");
    out property <image> eye: @image-url("../assets/icons/eye.svg");
    out property <image> eye-off: @image-url("../assets/icons/eye-off.svg");
    out property <image> history: @image-url("../assets/icons/history.svg");
    out property <image> key: @image-url("../assets/icons/key.svg");
}

export component IconButton inherits Button {
    colorize-icon: true;
    icon-size: 20px;
}

export component Icon inherits Image {
    width: 20px;
    height: 20px;
    image-fit: contain;
    colorize: Palette.foreground;
    accessible-role: none;
}
