import { StatusBadge, ThemePicker, SizeControl } from "visual.slint";
import { Icons, ToolButton } from "icons.slint";
import { AboutSlint, ScrollView, ComboBox, SpinBox, LineEdit, CheckBox, Palette } from "std-widgets.slint";
import { UiState } from "state.slint";
import { ActionButton, QuietButton, BodyText, HintText, SectionTitle, SettingField } from "components.slint";

component PermissionToggle inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled;
    forward-focus: checkbox;
    min-height: max(UiState.control-height, label.preferred-height + 16px);
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 8px;
        checkbox := CheckBox {
            width: 32px;
            enabled: root.enabled;
            checked <=> root.checked;
            accessible-label: root.text;
            toggled => { root.toggled(); }
        }
        label := BodyText {
            text: root.text;
            min-width: 0px;
            horizontal-stretch: 1;
            vertical-alignment: center;
            opacity: root.enabled ? 1 : 0.5;
            accessible-role: none;
            TouchArea {
                enabled: root.enabled;
                clicked => {
                    checkbox.focus();
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    in property <bool> active;
    in property <bool> compact;
    out property <length> form-width: max(0px, body.visible-width - 12px);
    out property <bool> form-wide: root.form-width >= 560px * UiState.scale;
    in-out property <length> scroll-position <=> body.content-y;
    private property <length> retained-scroll;
    changed active => {
        if root.active {
            body.content-y = max(min(0px, body.visible-height - body.content-height), root.retained-scroll);
        }
        else {
            root.retained-scroll = body.content-y;
        }
    }
    private property <bool> editing: root.active && UiState.category == 0;
    public function reveal-item(y: length, item-height: length) {
        if !root.editing {
            return;
        }
        if y < body.absolute-position.y {
            body.content-y = min(0px, body.content-y + body.absolute-position.y - y);
        }
        else if y + item-height > body.absolute-position.y + body.visible-height {
            body.content-y = max(min(0px, body.visible-height - body.content-height), body.content-y - (y + item-height - body.absolute-position.y - body.visible-height));
        }
    }
    public function focus-entry() {
        terminal-button.focus();
    }
    public function focus-error() {
        if UiState.error-field == "size" {
            body.content-y = min(0px, max(body.visible-height - body.content-height, body.content-y - (size-field.absolute-position.y - body.absolute-position.y)));
            size-edit.focus();
        }
        else if UiState.error-field == "font" {
            body.content-y = min(0px, max(body.visible-height - body.content-height, body.content-y - (font-field.absolute-position.y - body.absolute-position.y)));
            font-edit.focus();
        }
        else {
            body.content-y = 0px;
        }
    }
    GridLayout {
        spacing: 16px;
        Rectangle {
            row: 0;
            col: 0;
            min-width: root.compact ? 0px : UiState.control-height;
            max-width: root.compact ? 100000px : UiState.control-height;
            height: root.compact ? UiState.control-height : root.height;
            vertical-stretch: root.compact ? 0 : 1;
            GridLayout {
                spacing: 8px;
                terminal-button := QuietButton {
                    row: 0; col: 0;
                    icon-only: true; icon: Icons.desktop; text: "この端末";
                    enabled: root.active; checked: UiState.category == 0; checkable: true;
                    clicked => { UiState.category = 0; }
                }
                QuietButton {
                    row: root.compact ? 0 : 1; col: root.compact ? 1 : 0;
                    icon-only: true; icon: Icons.avatar; text: "コンパニオン";
                    enabled: root.active; checked: UiState.category == 1; checkable: true;
                    clicked => { UiState.category = 1; }
                }
                QuietButton {
                    row: root.compact ? 0 : 2; col: root.compact ? 2 : 0;
                    icon-only: true; icon: Icons.connection; text: "ホスト・接続";
                    enabled: root.active; checked: UiState.category == 2; checkable: true;
                    clicked => { UiState.category = 2; }
                }
                QuietButton {
                    row: root.compact ? 0 : 3; col: root.compact ? 3 : 0;
                    icon-only: true; icon: Icons.shield; text: "権限とデータ";
                    enabled: root.active; checked: UiState.category == 3; checkable: true;
                    clicked => { UiState.category = 3; }
                }
                Rectangle { row: root.compact ? 0 : 4; col: root.compact ? 4 : 0; horizontal-stretch: root.compact ? 1 : 0; vertical-stretch: root.compact ? 0 : 1; }
            }
        }
        Rectangle {
            row: root.compact ? 1 : 0;
            col: root.compact ? 0 : 1;
            min-width: 0px;
            vertical-stretch: 1;
            // Stacked persistent pages: hiding does not remove editor instances.
            VerticalLayout {
                visible: UiState.category == 0;
                spacing: 8px;
                body := ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        spacing: 12px;
                        padding: 0px;
                        padding-right: 12px;
                        if UiState.apply-error != "" : BodyText {
                            text: UiState.apply-error;
                            accessible-live-region: polite;
                        }
                        SectionTitle {
                            min-height: UiState.control-height;
                            vertical-alignment: center;
                            text: "外観";
                        }
                        SettingField {
                            label: "テーマ";
                            wide: root.form-wide;
                            ThemePicker {
                                ui-scale: UiState.scale;
                                height: UiState.control-height;
                                width: parent.control-width;
                                enabled: root.editing;
                                current-index <=> UiState.settings-draft.theme-index;
                                changed has-focus => { if self.has-focus { UiState.reveal-settings-item(self.absolute-position.y, self.height); } }
                                edited => { UiState.settings-edited(); }
                            }
                        }
                        font-field := SettingField {
                            label: "フォント名";
                            wide: root.form-wide;
                            font-edit := LineEdit {
                                changed has-focus => {
                                    if self.has-focus {
                                        UiState.reveal-settings-item(self.absolute-position.y, self.height);
                                    }
                                }
                                enabled: root.editing;
                                accessible-label: "フォント名";
                                width: parent.control-width;
                                height: UiState.control-height;
                                text <=> UiState.settings-draft.font-family;
                                edited => {
                                    UiState.settings-edited();
                                }
                            }
                        }
                        SettingField {
                            label: "文字サイズ";
                            wide: root.form-wide;
                            SpinBox {
                                changed has-focus => {
                                    if self.has-focus {
                                        UiState.reveal-settings-item(self.absolute-position.y, self.height);
                                    }
                                }
                                enabled: root.editing;
                                accessible-label: "文字サイズ";
                                width: parent.control-width;
                                height: UiState.control-height;
                                minimum: 12;
                                maximum: 28;
                                value <=> UiState.settings-draft.text-size;
                                edited => {
                                    UiState.settings-edited();
                                }
                            }
                        }
                        SectionTitle {
                            text: "デスクトップ表示";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding-left: root.form-wide ? 144px * UiState.scale + 12px : 0px;
                            QuietButton {
                                icon-only: true;
                                scroll-to-focus: true;
                                enabled: root.editing;
                                icon: UiState.avatar-visible ? Icons.eye-off : Icons.eye;
                                text: UiState.avatar-visible ? "キャラクターを隠す" : "キャラクターを表示";
                                clicked => {
                                    UiState.toggle-avatar();
                                }
                            }
                            QuietButton {
                                icon-only: true;
                                scroll-to-focus: true;
                                enabled: root.editing;
                                icon: Icons.center;
                                text: "キャラクターを画面中央へ戻す";
                                clicked => {
                                    UiState.recenter-avatar();
                                }
                            }
                            if UiState.avatar-failed : QuietButton {
                                icon-only: true;
                                scroll-to-focus: true;
                                enabled: root.editing;
                                icon: Icons.refresh;
                                text: "描画エラーから再起動";
                                clicked => {
                                    UiState.restart-avatar();
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if UiState.avatar-failed : BodyText { text: UiState.avatar-status; }
                        size-field := SettingField {
                            label: "大きさ";
                            wide: root.form-wide;
                            size-edit := SizeControl {
                                ui-scale: UiState.scale;
                                changed has-focus => {
                                    if self.has-focus {
                                        UiState.reveal-settings-item(self.absolute-position.y, self.height);
                                    }
                                }
                                enabled: root.editing;
                                width: parent.control-width;
                                height: UiState.control-height;
                                text <=> UiState.settings-draft.size-text;
                                edited => {
                                    UiState.settings-edited();
                                }
                            }
                        }
                        SettingField {
                            label: "描画速度";
                            wide: root.form-wide;
                            ComboBox {
                                changed has-focus => {
                                    if self.has-focus {
                                        UiState.reveal-settings-item(self.absolute-position.y, self.height);
                                    }
                                }
                                enabled: root.editing;
                                accessible-label: "描画速度";
                                width: parent.control-width;
                                height: UiState.control-height;
                                model: ["30 fps", "60 fps"];
                                current-index <=> UiState.settings-draft.fps-index;
                                selected => {
                                    UiState.settings-edited();
                                }
                            }
                        }
                        SectionTitle {
                            text: "ローカル素材・モーション";
                        }
                        SettingField {
                            label: "VRMファイル";
                            wide: root.form-wide;
                            LineEdit {
                                changed has-focus => {
                                    if self.has-focus {
                                        UiState.reveal-settings-item(self.absolute-position.y, self.height);
                                    }
                                }
                                enabled: root.editing;
                                accessible-label: "VRMファイル";
                                x: 0px;
                                width: max(0px, parent.control-width - UiState.control-height - 8px);
                                height: UiState.control-height;
                                text <=> UiState.settings-draft.model;
                                edited => {
                                    UiState.settings-edited();
                                }
                            }
                            ToolButton {
                                ui-scale: UiState.scale;
                                x: parent.control-width - self.width;
                                y: (parent.height - self.height) / 2;
                                icon: Icons.folder;
                                label: "VRMを選ぶ";
                                enabled: root.editing && !UiState.picker-active;
                                changed has-focus => { if self.has-focus { UiState.reveal-settings-item(self.absolute-position.y, self.height); } }
                                clicked => { UiState.select-model(); }
                            }
                        }

                        SettingField {
                            label: "VRMAファイル";
                            wide: root.form-wide;
                            LineEdit {
                                changed has-focus => {
                                    if self.has-focus {
                                        UiState.reveal-settings-item(self.absolute-position.y, self.height);
                                    }
                                }
                                enabled: root.editing;
                                accessible-label: "VRMAファイル";
                                x: 0px;
                                width: max(0px, parent.control-width - UiState.control-height - 8px);
                                height: UiState.control-height;
                                text <=> UiState.settings-draft.motion;
                                edited => {
                                    UiState.settings-edited();
                                }
                            }
                            ToolButton {
                                ui-scale: UiState.scale;
                                x: parent.control-width - self.width;
                                y: (parent.height - self.height) / 2;
                                icon: Icons.folder;
                                label: "VRMAを選ぶ";
                                enabled: root.editing && !UiState.picker-active;
                                changed has-focus => { if self.has-focus { UiState.reveal-settings-item(self.absolute-position.y, self.height); } }
                                clicked => { UiState.select-motion(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            padding-left: root.form-wide ? 144px * UiState.scale + 12px : 0px;
                            QuietButton {
                                icon-only: true;
                                scroll-to-focus: true;
                                icon: Icons.reset;
                                text: "静止姿勢に戻す";
                                enabled: root.editing && UiState.settings-draft.motion != "";
                                clicked => {
                                    UiState.settings-draft.motion = "";
                                    UiState.settings-edited();
                                }
                            }
                            QuietButton {
                                icon-only: true;
                                scroll-to-focus: true;
                                icon: UiState.settings-draft.motion-playing ? Icons.pause : Icons.motion;
                                text: UiState.settings-draft.motion-playing ? "一時停止" : "モーションを再生";
                                enabled: root.editing && UiState.settings-draft.motion != "";
                                checkable: true;
                                checked: UiState.settings-draft.motion-playing;
                                clicked => {
                                    UiState.settings-draft.motion-playing = !UiState.settings-draft.motion-playing;
                                    UiState.settings-edited();
                                }
                            }
                            QuietButton {
                                icon-only: true;
                                scroll-to-focus: true;
                                icon: Icons.loop;
                                text: "繰り返し再生";
                                enabled: root.editing && UiState.settings-draft.motion != "";
                                checkable: true;
                                checked: UiState.settings-draft.motion-loop;
                                clicked => {
                                    UiState.settings-draft.motion-loop = !UiState.settings-draft.motion-loop;
                                    UiState.settings-edited();
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if UiState.motion-failed : BodyText { text: UiState.motion-status; }
                        SectionTitle {
                            text: "アプリ情報";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            StatusBadge { icon: Icons.tray; state: UiState.tray-ready ? 1 : 3; label: UiState.tray-status; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        AboutSlint {
                            vertical-stretch: 0;
                        }
                    }
                }
                if UiState.apply-error != "" : HorizontalLayout {
                    vertical-stretch: 0;
                    ActionButton {
                        icon: Icons.settings;
                        text: "エラーの詳細";
                        fill-width: false;
                        enabled: root.editing;
                        clicked => {
                            root.focus-error();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-right: 12px;
                    vertical-stretch: 0;
                    StatusBadge { icon: Icons.save; state: UiState.settings-dirty ? 2 : 1; label: UiState.settings-dirty ? "未保存の変更" : UiState.save-status == "" ? "保存済み" : UiState.save-status; accessible-live-region: polite; }
                    Rectangle { horizontal-stretch: 1; }
                    QuietButton {
                        icon-only: true;
                        icon: Icons.reset;
                        text: "変更を戻す";
                        enabled: root.editing && UiState.settings-dirty;
                        clicked => { UiState.reset-settings(); }
                    }
                    ActionButton {
                        icon-only: true;
                        icon: Icons.save;
                        text: "保存";
                        primary: true;
                        fill-width: false;
                        enabled: root.editing && UiState.settings-dirty;
                        clicked => { UiState.save-settings(); }
                    }
                }
            }
            if UiState.category != 0 : ScrollView {
                content-width: self.visible-width;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    alignment: start;
                    spacing: 12px;
                    padding: 0px;
                    padding-right: 12px;
                    SectionTitle {
                        min-height: UiState.control-height;
                        vertical-alignment: center;
                        text: UiState.category == 1 ? "コンパニオン" : UiState.category == 2 ? "ホスト・接続" : "権限とデータ";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        StatusBadge {icon: Icons.desktop; state: UiState.host-connected ? 1 : 0; label: UiState.host-connected ? "このPCのホストに保存" : "ホスト未接続";}
                        if !UiState.host-connected : QuietButton {icon-only: true; icon: Icons.connection; text: "ホスト選択"; enabled: root.active; clicked => {UiState.show-host-selection();}}
                        Rectangle {horizontal-stretch: 1;}
                    }
                    if UiState.category == 1 : VerticalLayout {
                        alignment: start;
                        vertical-stretch: 0;
                        spacing: 10px;
                        SettingField {
                            label: "名前";
                            wide: root.form-wide;
                            LineEdit {
                                width: parent.control-width;
                                height: UiState.control-height;
                                accessible-label: "名前";
                                text <=> UiState.companion-name;
                                enabled: root.active && UiState.host-connected;
                                edited => { UiState.host-dirty = true; }
                            }
                        }
                        SettingField {
                            label: "口調・人格";
                            wide: root.form-wide;
                            LineEdit {
                                width: parent.control-width;
                                height: UiState.control-height;
                                accessible-label: "口調・人格";
                                text <=> UiState.companion-mind;
                                enabled: root.active && UiState.host-connected;
                                edited => { UiState.host-dirty = true; }
                            }
                        }
                        HorizontalLayout {
                            Rectangle {horizontal-stretch: 1;}
                            ActionButton {icon-only: true;icon: Icons.save; text: "名前と口調を保存"; enabled: root.active && UiState.host-connected; clicked => {UiState.save-companion();} }
                        }
                        BodyText {text: "モデル";}
                        HintText {text: UiState.model-id;}
                    }
                    if UiState.category == 2 : VerticalLayout {
                        alignment: start;
                        vertical-stretch: 0;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            StatusBadge {icon: Icons.connection; state: UiState.connection-matches-provider ? 1 : 0; label: UiState.connection-matches-provider ? "接続 · 設定済み" : "接続 · 未設定";}
                            SectionTitle {text: "プロバイダー"; horizontal-stretch: 1; vertical-alignment: center;}
                            ActionButton {icon-only: true; icon: Icons.settings; text: "接続とモデルを保存"; enabled: root.active && UiState.host-connected && UiState.provider-ready && UiState.model-id != ""; clicked => {UiState.configure-host();}}
                        }
                        HintText {text: UiState.model-id;}
                        HorizontalLayout {
                            ComboBox {model: UiState.provider-names; current-index <=> UiState.provider-index; enabled: root.active && UiState.host-connected; horizontal-stretch: 1; selected(value) => {UiState.choose-provider(self.current-index);}}
                            QuietButton {icon-only: true; icon: Icons.reset; text: "プラグインを再走査"; enabled: root.active && UiState.host-connected; clicked => {UiState.reload-providers();}}
                            if UiState.provider-plugin : QuietButton {icon: Icons.connection; text: UiState.provider-ready ? "無効化" : "有効化"; enabled: root.active && UiState.host-connected; clicked => {UiState.toggle-provider();}}
                        }
                        StatusBadge {icon: Icons.connection; state: UiState.provider-ready ? 1 : 0; label: UiState.provider-state;}
                        if UiState.provider-error != "" : HintText {text: UiState.provider-error;}
                        BodyText {text: "接続先";}
                        LineEdit {text <=> UiState.provider-endpoint; accessible-label: "接続先URL"; enabled: root.active && UiState.provider-ready; edited => {UiState.host-dirty=true; UiState.connection-matches-provider=false;}}
                        for field in UiState.provider-fields : VerticalLayout {
                            spacing: 4px;
                            BodyText {text: field.label;}
                            if field.kind < 2 : LineEdit {text <=> field.value; accessible-label: field.label; input-type: field.kind == 1 ? number : text; enabled: root.active && UiState.provider-ready; edited => {UiState.host-dirty=true; UiState.connection-matches-provider=false;}}
                            if field.kind == 2 : CheckBox {text: field.label; checked <=> field.checked; enabled: root.active && UiState.provider-ready; toggled => {UiState.host-dirty=true;}}
                            if field.kind == 3 : ComboBox {model: field.choices; current-value <=> field.value; enabled: root.active && UiState.provider-ready; selected(value) => {UiState.host-dirty=true; UiState.connection-matches-provider=false;}}
                        }
                        BodyText {text: "モデルID";}
                        HorizontalLayout {
                            LineEdit {text <=> UiState.model-id; accessible-label: "モデルID"; placeholder-text: "モデルIDを直接入力"; enabled: root.active && UiState.provider-ready; horizontal-stretch: 1; edited => {UiState.host-dirty=true; UiState.connection-matches-provider=false;}}
                            if UiState.model-list-supported : QuietButton {icon-only: true; icon: Icons.reset; text: "モデル一覧を取得"; hint: "送信許可の疎通確認・モデル情報を有効にしてください"; enabled: root.active && UiState.connection-matches-provider; clicked => {UiState.fetch-models();}}
                        }
                        if UiState.model-ids.length > 0 : ComboBox {model: UiState.model-ids; current-value <=> UiState.model-id; enabled: root.active && UiState.provider-ready; selected(value) => {UiState.host-dirty=true; UiState.connection-matches-provider=false;}}
                        if UiState.requires-credentials : HorizontalLayout {
                            spacing: 8px;
                            StatusBadge {icon: Icons.key; state: UiState.credential-state == 0 ? 0 : 1; label: UiState.credential-state == 1 ? "APIキー · 保存済み" : UiState.credential-state == 2 ? "APIキー · 今回のホスト起動中のみ保持" : "APIキー · 未登録";}
                            SectionTitle {text: "APIキー"; horizontal-stretch: 1; vertical-alignment: center;}
                        }
                        if UiState.requires-credentials : HorizontalLayout {
                            spacing: 8px;
                            LineEdit {text <=> UiState.api-key; accessible-label: "APIキー"; placeholder-text: "APIキー"; input-type: password; enabled: root.active && UiState.host-connected; min-width: 0px; min-height: UiState.control-height; max-height: UiState.control-height; horizontal-stretch: 1;}
                            ActionButton {icon-only: true; icon: Icons.save; text: "APIキーを登録"; hint: "ホストへ登録（この端末には保存しません）"; enabled: root.active && UiState.host-connected && UiState.connection-matches-provider && UiState.api-key != ""; clicked => {UiState.register-credential();}}
                        }
                        if UiState.requires-credentials : HorizontalLayout {
                            spacing: 8px;
                            QuietButton {icon: Icons.key; text: "環境変数から"; hint: "ホストの" + UiState.environment-variable + "を使う"; enabled: root.active && UiState.host-connected && UiState.connection-matches-provider && UiState.environment-variable != ""; clicked => {UiState.environment-credential();}}
                            QuietButton {icon-only: true; icon: Icons.reset; text: "資格情報を解除"; enabled: root.active && UiState.host-connected && UiState.connection-matches-provider && UiState.credential-state != 0; clicked => {UiState.revoke-credential();}}
                            Rectangle {horizontal-stretch: 1;}
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {icon-only: true; icon: Icons.connection; text: "疎通確認"; enabled: root.active && UiState.host-connected; clicked => {UiState.check-connection();}}
                            QuietButton {icon-only: true; icon: Icons.shield; text: "送信許可"; enabled: root.active; clicked => {UiState.category = 3;}}
                            Rectangle {horizontal-stretch: 1;}
                        }
                    }
                    if UiState.category == 3 : VerticalLayout {
                        alignment: start;
                        vertical-stretch: 0;
                        spacing: 10px;
                        BodyText {text: UiState.destinations;}
                        PermissionToggle {text: "会話本文・履歴・口調を送信する"; checked <=> UiState.allow-conversation; enabled: root.active && UiState.host-connected && UiState.connection-matches-provider; toggled => {UiState.host-dirty=true;} }
                        PermissionToggle {text: "疎通確認・モデル情報を送受信する"; checked <=> UiState.allow-check; enabled: root.active && UiState.host-connected && UiState.connection-matches-provider; toggled => {UiState.host-dirty=true;} }
                        HorizontalLayout {
                            Rectangle {horizontal-stretch: 1;}
                            ActionButton {icon-only: true;icon: Icons.save; text: "送信許可を保存"; enabled: root.active && UiState.host-connected && UiState.connection-matches-provider; clicked => {UiState.save-permissions();} }
                        }
                        HintText {text: "許可解除は生成中の返答も停止します。送信済みデータは取り消せません。";}
                    }
                    if UiState.host-feedback != "" : HorizontalLayout {
                        spacing: 8px;
                        StatusBadge {icon: UiState.host-feedback-error ? Icons.warning : Icons.check; state: UiState.host-feedback-error ? 3 : 1; label: UiState.host-feedback; accessible-live-region: polite;}
                        if UiState.host-feedback-error : BodyText {text: UiState.host-feedback; horizontal-stretch: 1;}
                        if !UiState.host-feedback-error : Rectangle {horizontal-stretch: 1;}
                    }
                }
            }
        }
    }
}
