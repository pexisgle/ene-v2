import { StatusBadge, ThemePicker, SizeControl, MessageBubble } from "visual.slint";
import { Icons, ToolButton, Icon } from "icons.slint";
import { AboutSlint, Button, ScrollView, VerticalBox, HorizontalBox, LineEdit, SpinBox, CheckBox, ComboBox, Palette } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";
export global Theme {
    public function apply(index: int) {
        Palette.color-scheme = index == 2 ? ColorScheme.dark : index == 1 ? ColorScheme.light : ColorScheme.unknown;
    }
}

export struct ChatEntry {
    author: string,
    body: string,
    provisional: bool,
}

component MessageInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> font-family <=> input.font-family;
    in property <length> font-size <=> input.font-size;
    in property <string> placeholder-text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback submit;
    private property <bool> composing;
    private property <bool> ime-settling;
    Timer {
        interval: 150ms;
        running: root.ime-settling;
        triggered => { root.ime-settling = false; }
    }
    forward-focus: input;
    background: Palette.control-background;
    border-width: 1px;
    border-color: input.has-focus ? Palette.accent-background : Palette.border;
    border-radius: 4px;
    ContextMenuArea {
        Menu {
            MenuItem { title: "切り取り"; activated => { input.cut(); } }
            MenuItem { title: "コピー"; activated => { input.copy(); } }
            MenuItem { title: "貼り付け"; activated => { input.paste(); } }
            MenuItem { title: "すべて選択"; activated => { input.select-all(); } }
        }
        scroll := ScrollView {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            height: parent.height - 16px;
            content-width: self.visible-width;
            content-height: max(self.visible-height, input.preferred-height);
            input := TextInput {
                width: scroll.visible-width;
                height: max(scroll.visible-height, self.preferred-height);
                single-line: false;
                wrap: word-wrap;
                color: Palette.foreground;
                selection-background-color: Palette.selection-background;
                selection-foreground-color: Palette.selection-foreground;
                page-height: scroll.visible-height;
                edited => { root.edited(self.text); }
                changed preedit-text => {
                    if self.preedit-text != "" {
                        root.composing = true;
                        root.ime-settling = false;
                    } else if root.composing {
                        root.composing = false;
                        // Some IMEs finish composition before forwarding Enter.
                        // Key release clears this; a short fallback also covers
                        // confirmation by mouse or IMEs consuming the release.
                        root.ime-settling = true;
                    }
                }
                key-released(event) => {
                    if event.text == Key.Return { root.ime-settling = false; }
                    return reject;
                }
                key-pressed(event) => {
                    if event.text == Key.Return {
                        // An IME confirmation is never a send or a newline.
                        if self.preedit-text != "" || root.ime-settling { return accept; }
                        if !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                            if !event.repeat { root.submit(); }
                            return accept;
                        }
                    }
                    return reject;
                }
                cursor-position-changed(pos) => {
                    if pos.y + scroll.content-y < 0px {
                        scroll.content-y = min(0px, max(scroll.visible-height - self.height, -pos.y));
                    } else if pos.y + scroll.content-y > scroll.visible-height - root.font-size {
                        scroll.content-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - pos.y - root.font-size));
                    }
                }
            }
        }
    }
    Text {
        x: scroll.x;
        y: scroll.y;
        width: scroll.width;
        text: root.text == "" && input.preedit-text == "" ? root.placeholder-text : "";
        font-family: root.font-family;
        font-size: root.font-size;
        color: Palette.foreground;
        opacity: 0.6;
        overflow: elide;
        accessible-role: none;
    }
}

export component ChatWindow inherits Window {
    callback tray-action(int);
    title: "ene — 会話";
    preferred-width: 640px;
    preferred-height: 760px;
    min-width: 420px;
    min-height: 480px;
    background: Palette.background;
    default-font-family: root.font-family;
    default-font-size: root.text-size * 1px;

    in-out property <string> font-family: "Noto Sans CJK JP";
    in-out property <int> text-size: 16;
    in property <int> theme-index;
    in-out property <string> draft;
    in property <[ChatEntry]> messages;
    in property <bool> can-send;
    in property <bool> demo-mode;
    in property <bool> tray-ready;
    in property <string> status;
    in property <string> avatar-model;
    in property <string> avatar-motion;
    in property <bool> motion-playing;
    in property <bool> motion-loop;
    in property <string> motion-status;
    in property <bool> motion-failed;
    in property <bool> avatar-visible;
    in property <int> avatar-fps-index;
    in property <int> avatar-size-percent: 100;
    in property <bool> avatar-failed;
    in property <string> avatar-status;
    callback avatar-events-available;
    callback restart-avatar;
    in property <string> tray-status: "トレイを確認しています…";
    out property <bool> editor-focused: editor.has-focus;
    out property <length> composer-height: composer.height;
    out property <length> conversation-height: history.visible-height;
    callback draft-edited(string);
    callback submit;
    callback open-settings;

    public function focus-input() { editor.focus(); }
    public function scroll-to-latest() {
        history.content-y = min(0px, history.visible-height - history.content-height);
    }

    VerticalBox {
        padding: 12px;
        spacing: 10px;
        HorizontalBox {
            Image { source: @image-url("../assets/ene.svg"); width: 28px; height: 28px; }
            VerticalBox {
                padding: 0px;
                spacing: 2px;
                Text { text: "ene"; font-size: 20px; font-weight: 700; color: Palette.foreground; }

            }
            Rectangle { horizontal-stretch: 1; }
            StatusBadge { icon: root.demo-mode ? Icons.demo : Icons.connection; label: root.demo-mode ? "デモ · 外部送信なし・会話は保存しません" : "ホスト未接続"; }
            ToolButton { icon: Icons.settings; label: "設定"; clicked => { root.open-settings(); } }
        }

        if root.avatar-failed : HorizontalBox {
            padding: 4px;
            Text { text: root.avatar-status; wrap: word-wrap; font-size: 12px; color: Palette.foreground; horizontal-stretch: 1; }
            ToolButton { icon: Icons.settings; label: "設定"; clicked => { root.open-settings(); } }
            ToolButton { icon: Icons.refresh; label: "再起動"; clicked => { root.restart-avatar(); } }
        }
        if root.motion-failed : HorizontalBox {
            padding: 4px;
            Text { text: root.motion-status; wrap: word-wrap; font-size: 12px; color: Palette.foreground; horizontal-stretch: 1; }
            ToolButton { icon: Icons.settings; label: "設定"; clicked => { root.open-settings(); } }
        }
        history := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalBox {
                padding: 4px;
                spacing: 12px;
                if root.messages.length == 0 : Rectangle {
                    min-height: 160px;
                    Icon { source: Icons.avatar; width: 64px; height: 64px; x: (parent.width - self.width) / 2; y: 40px; opacity: 0.35; }
                }
                for entry in root.messages : MessageBubble {
                    author: entry.author; body: entry.body; provisional: entry.provisional;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        composer := Rectangle {
            background: Palette.alternate-background;
            border-radius: 12px;
            vertical-stretch: 0;
            height: min(180px, max(86px, draft-measure.preferred-height + 54px));
            draft-measure := Text {
                visible: false;
                height: 0px;
                width: max(1px, editor.width - 20px);
                text: root.draft;
                font-family: root.font-family;
                font-size: root.text-size * 1px;
                wrap: word-wrap;
            }
            VerticalBox {
                width: parent.width;
                height: parent.height;
                padding: 10px;
                spacing: 6px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 10px;
                    vertical-stretch: 1;
                    editor := MessageInput {
                        text <=> root.draft;
                        font-family: root.font-family;
                        font-size: root.text-size * 1px;
                        placeholder-text: root.demo-mode ? "メッセージを入力…" : "ホスト未接続";
                        min-height: 36px;
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        edited(text) => { root.draft-edited(text); }
                        submit => { if root.can-send { root.submit(); } }
                    }
                    VerticalBox {
                        padding: 0px;
                        Rectangle { vertical-stretch: 1; }
                        ToolButton { icon: Icons.send; label: "送信 · Enter（改行はShift+Enter）"; enabled: root.can-send; clicked => { root.submit(); } }
                    }
                }

            }
        }

    }
}

export component SettingsWindow inherits Window {
    title: "ene — 設定";
    preferred-width: 440px;
    preferred-height: 680px;
    min-width: 360px;
    default-font-family: "Noto Sans CJK JP";
    in-out property <string> font-family;
    in-out property <int> text-size;
    in-out property <int> theme-index;
    callback apply-settings;
    in-out property <string> apply-error;
    callback commit-avatar-settings() -> bool;
    commit-avatar-settings => { true }
    in-out property <string> avatar-model;
    in-out property <string> avatar-motion;
    in-out property <bool> motion-playing;
    in-out property <bool> motion-loop;
    in property <string> motion-status;
    callback select-motion;
    in-out property <bool> avatar-visible;
    in-out property <int> avatar-fps-index;
    in-out property <int> avatar-size-percent: 100;
    in-out property <string> avatar-size-text: root.avatar-size-percent;
    in property <string> avatar-status;
    in property <bool> avatar-failed;
    callback select-model;
    callback restart-avatar;
    callback recenter-avatar;
    in property <bool> tray-ready;
    in property <string> tray-status;
    callback quit;

    min-height: 360px;
    VerticalBox {
        padding: 16px;
        spacing: 12px;
        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalBox {
                padding: 8px;
                spacing: 14px;
                Text { text: "会話画面の表示"; font-size: 20px; font-weight: 600; }
                HorizontalBox {
                    padding: 0px;
                    Text { text: "テーマ"; vertical-alignment: center; }
                    ThemePicker { current-index <=> root.theme-index; }
                }
                Text { text: "フォント"; }
                LineEdit { text <=> root.font-family; }
                HorizontalBox {
                    padding: 0px;
                    Text { text: "文字サイズ"; vertical-alignment: center; }
                    SpinBox { value <=> root.text-size; minimum: 12; maximum: 28; }
                }
                HorizontalBox { padding: 0px; spacing: 8px; Icon { source: Icons.avatar; } Text { text: "キャラクター"; font-size: 18px; font-weight: 600; } }
                CheckBox { text: "キャラクターを表示"; checked <=> root.avatar-visible; }
                Text { text: root.avatar-model; wrap: word-wrap; font-size: 12px; color: Palette.foreground; opacity: 0.7; }
                HorizontalBox {
                    padding: 0px;
                    ToolButton { icon: Icons.folder; label: "VRMを選ぶ"; clicked => { root.select-model(); } }
                    Text { text: "描画速度"; font-size: 13px; vertical-alignment: center; }
                    ComboBox { model: ["30 fps", "60 fps"]; current-index <=> root.avatar-fps-index; }
                }
                HorizontalBox {
                    padding: 0px;
                    Text { text: "キャラクターの大きさ"; vertical-alignment: center; }
                    SizeControl { text <=> root.avatar-size-text; }
                }
                HorizontalBox { padding: 0px; ToolButton { icon: Icons.center; label: "キャラクターを画面中央へ戻す"; clicked => { root.recenter-avatar(); } } Rectangle { horizontal-stretch: 1; } }
                if root.avatar-failed : Text { text: root.avatar-status; wrap: word-wrap; font-size: 12px; color: Palette.foreground; }
                HorizontalBox { padding: 0px; spacing: 8px; Icon { source: Icons.motion; } Text { text: "モーション（VRMA 1.0）"; font-size: 16px; font-weight: 600; } }
                Text { text: root.avatar-motion == "" ? "未選択 · 静止姿勢" : root.avatar-motion; wrap: word-wrap; font-size: 12px; color: Palette.foreground; opacity: 0.7; }
                HorizontalBox {
                    padding: 0px;
                    ToolButton { icon: Icons.folder; label: "VRMAを選ぶ"; clicked => { root.select-motion(); } }
                    ToolButton { icon: Icons.reset; label: "静止姿勢に戻す"; enabled: root.avatar-motion != ""; clicked => { root.avatar-motion = ""; } }
                }
                HorizontalBox {
                    padding: 0px;
                    ToolButton { icon: root.motion-playing ? Icons.pause : Icons.motion; label: root.motion-playing ? "一時停止" : "モーションを再生"; checkable: true; checked <=> root.motion-playing; enabled: root.avatar-motion != ""; }
                    ToolButton { icon: Icons.loop; label: "繰り返し再生"; checkable: true; checked <=> root.motion-loop; enabled: root.avatar-motion != ""; }
                }
                HorizontalBox { padding: 0px; StatusBadge { icon: Icons.motion; label: root.motion-status; } Rectangle { horizontal-stretch: 1; } }
                if root.avatar-failed : HorizontalBox { padding: 0px; ToolButton { icon: Icons.refresh; label: "描画エラーから再起動"; clicked => { root.restart-avatar(); } } Rectangle { horizontal-stretch: 1; } }
                HorizontalBox { padding: 0px; StatusBadge { icon: Icons.tray; label: root.tray-status; state: root.tray-ready ? 1 : 3; } Rectangle { horizontal-stretch: 1; } }
                if !root.tray-ready : HorizontalBox { padding: 0px; ToolButton { icon: Icons.exit; label: "クライアント終了"; clicked => { root.quit(); } } Rectangle { horizontal-stretch: 1; } }
                AboutSlint { preferred-height: 100px; max-height: 120px; vertical-stretch: 0; }
            }
        }
        if root.apply-error != "" : Text { text: root.apply-error; wrap: word-wrap; color: Palette.foreground; font-size: 12px; }
        HorizontalBox { Rectangle { horizontal-stretch: 1; } ToolButton { icon: Icons.save; label: "適用して閉じる"; clicked => { root.apply-settings(); } } }
    }
}
