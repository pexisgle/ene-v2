import { StatusBadge } from "visual.slint";
import { Icons } from "icons.slint";
import { Palette, ScrollView } from "std-widgets.slint";
import { UiState } from "state.slint";
export { UiState, Theme, SettingsDraft, ChatEntry } from "state.slint";
import { ConversationView } from "conversation.slint";
import { HostSelectionView } from "host-selection.slint";
import { SettingsView } from "settings.slint";
import { ActionButton, QuietButton, BodyText, HintText } from "components.slint";
component QuitConfirmation inherits Rectangle {
    in property <bool> active;
    background: Palette.background;
    accessible-role: region;
    accessible-label: "終了確認";
    public function focus-return() {
        return-button.focus();
    }
    ScrollView {
        width: parent.width;
        height: parent.height;
        content-width: self.visible-width;
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            BodyText {
                text: "未保存の変更があります";
                font-weight: 600;
            }
            BodyText {
                text: "変更を破棄してクライアントを終了しますか？ホストは終了しません。";
            }
            return-button := ActionButton {
                icon: Icons.reset;
                text: "戻る";
                enabled: root.active;
                clicked => {
                    UiState.cancel-quit();
                }
            }
            ActionButton {
                icon: Icons.exit;
                text: "破棄して終了";
                enabled: root.active;
                clicked => {
                    UiState.discard-and-quit();
                }
            }
        }
    }
}
export component AppWindow inherits Window {
    title: "ene";
    preferred-width: 720px;
    preferred-height: 760px;
    min-width: 420px;
    min-height: 480px;
    background: Palette.background;
    default-font-family: UiState.font-family;
    default-font-size: UiState.text-size * 1px;
    callback tray-action(int);
    callback file-selection-ready(string, bool, string, bool, bool);
    callback avatar-events-available;
    private property <length> measured-width: 720px;
    changed width => {
        root.measured-width = self.width;
    }
    out property <length> layout-padding: root.measured-width < 680px * UiState.scale ? 12px : 20px;
    out property <bool> compact: root.measured-width - 2 * root.layout-padding < 640px * UiState.scale;
    out property <bool> editor-focused: conversation.editor-focused;
    out property <length> composer-height: conversation.composer-height;
    out property <length> conversation-height: conversation.conversation-height;
    out property <length> history-position: conversation.history-position;
    in-out property <length> history-scroll <=> conversation.scroll-position;
    in-out property <length> settings-scroll <=> settings.scroll-position;
    out property <length> settings-form-width: settings.form-width;
    out property <bool> settings-form-wide: settings.form-wide;
    public function focus-entry() {
        if UiState.quit-confirmation { quit-panel.focus-return(); }
        else if UiState.host-selection-visible { host-selection.focus-entry(); }
        else if UiState.page == 0 { conversation.focus-input(); }
        else { settings.focus-entry(); }
    }
    public function focus-input() {
        conversation.focus-input();
    }
    public function scroll-to-latest() {
        conversation.scroll-to-latest();
    }
    public function focus-settings() {
        settings.focus-entry();
    }
    public function reveal-settings-item(y: length, h: length) {
        settings.reveal-item(y, h);
    }
    public function focus-quit() {
        quit-panel.focus-return();
    }
    public function focus-error() {
        settings.focus-error();
    }
    Rectangle {
        width: min(root.width, (UiState.host-selection-visible ? 600px * UiState.scale : UiState.page == 0 ? 800px * UiState.scale : 960px * UiState.scale + 12px) + 2 * root.layout-padding);
        x: (root.width - self.width) / 2;
        min-height: 0px;
        shell := VerticalLayout {
            padding: root.layout-padding;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                padding-right: 12px;
                min-height: UiState.control-height;
                BodyText { text: UiState.host-selection-visible ? "ホスト選択" : "ene"; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                StatusBadge { icon: UiState.demo-mode ? Icons.demo : Icons.connection; label: UiState.demo-mode ? "デモ · 外部送信なし・会話は保存しません" : "ホスト未接続"; }
                StatusBadge { icon: UiState.avatar-visible ? Icons.avatar : Icons.eye-off; state: UiState.avatar-failed ? 3 : !UiState.avatar-visible ? 0 : UiState.avatar-ready ? 1 : 2; label: UiState.avatar-status; }
                if UiState.avatar-failed || UiState.motion-failed || !UiState.tray-ready || UiState.apply-error != "" : QuietButton {
                    icon-only: true;
                    icon: Icons.warning;
                    text: UiState.apply-error != "" ? "保存・操作エラーを確認" : UiState.avatar-failed || UiState.motion-failed ? "キャラクターの状態を確認" : "トレイなし · ホスト選択";
                    enabled: !UiState.quit-confirmation;
                    clicked => {
                        if UiState.avatar-failed || UiState.motion-failed || UiState.apply-error != "" {
                            UiState.category = 0;
                            UiState.navigate(1);
                            if UiState.apply-error != "" { root.focus-error(); }
                        } else { UiState.show-host-selection(); }
                    }
                }
                if !UiState.host-selection-visible : HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    if UiState.page == 1 && UiState.session-active : QuietButton {
                        icon-only: true;
                        icon: Icons.desktop;
                        text: "ホスト選択";
                        enabled: !UiState.quit-confirmation;
                        clicked => { UiState.show-host-selection(); }
                    }
                    QuietButton {
                        icon-only: true;
                        icon: UiState.page == 0 ? Icons.settings : Icons.back;
                        text: UiState.page == 0 ? "設定" : UiState.session-active ? "対話に戻る" : "ホスト選択に戻る";
                        enabled: !UiState.quit-confirmation;
                        clicked => { UiState.navigate(UiState.page == 0 ? 1 : 0); }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                host-selection := HostSelectionView {
                    width: parent.width;
                    x: 0px;
                    visible: UiState.host-selection-visible;
                    active: UiState.host-selection-visible && !UiState.quit-confirmation;
                }
                conversation := ConversationView {
                    width: parent.width;
                    x: 0px;
                    visible: !UiState.host-selection-visible && UiState.page == 0;
                    active: !UiState.host-selection-visible && UiState.page == 0 && !UiState.quit-confirmation;
                    compact: root.compact;
                }
                settings := SettingsView {
                    width: parent.width;
                    x: 0px;
                    visible: !UiState.host-selection-visible && UiState.page == 1;
                    active: !UiState.host-selection-visible && UiState.page == 1 && !UiState.quit-confirmation;
                    compact: root.compact;
                }
            }
        }
    }
    quit-panel := QuitConfirmation {
        visible: UiState.quit-confirmation;
        active: UiState.quit-confirmation;
    }
}
