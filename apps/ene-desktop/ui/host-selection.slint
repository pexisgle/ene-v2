import { StatusBadge } from "visual.slint";
import { Icons } from "icons.slint";
import { ScrollView, Palette } from "std-widgets.slint";
import { UiState } from "state.slint";
import { ActionButton, QuietButton, BodyText, HintText, SectionTitle } from "components.slint";

export component HostSelectionView inherits Rectangle {
    in property <bool> active;
    public function focus-entry() {
        if UiState.demo-mode { demo-start.focus(); }
        else { local-settings.focus(); }
    }
    VerticalLayout {
        spacing: 12px;
        ScrollView {
            min-height: 0px;
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                padding: 0px;
                padding-right: 12px;
                spacing: 12px;
                Rectangle {
                    background: Palette.alternate-background;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.border;
                    min-height: card.min-height;
                    card := VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        HorizontalLayout {
                            StatusBadge { icon: Icons.desktop; label: "このPCのホスト"; }
                            SectionTitle { text: "このPC"; vertical-alignment: center; horizontal-stretch: 1; }
                            if UiState.demo-mode : StatusBadge {icon: Icons.demo; label: "デモ · 外部送信なし・会話は保存しません";}
                        }
                        HorizontalLayout {
                            demo-start := ActionButton {
                                visible: UiState.demo-mode;
                                enabled: root.active && UiState.demo-mode;
                                icon-only: true;
                                primary: true;
                                icon: Icons.chat;
                                text: UiState.session-active ? "対話を続ける" : "対話を始める";
                                clicked => { UiState.start-demo(); }
                            }
                            Rectangle {horizontal-stretch: 1;}
                        }
                    }
                }
            }
        }
        GridLayout {
            padding-right: 12px;
            vertical-stretch: 0;
            spacing: 8px;
            local-settings := QuietButton {
                row: 0; col: 0;
                icon-only: true;
                icon: Icons.settings;
                text: "この端末の設定";
                enabled: root.active;
                clicked => { UiState.category = 0; UiState.navigate(1); }
            }
            Rectangle { row: 0; col: 1; horizontal-stretch: 1; }
            QuietButton {
                row: 0;
                col: 2;
                icon-only: true;
                icon: Icons.exit;
                text: "クライアント終了";
                hint: "クライアントのみを終了します。ホストは稼働を続けます。";
                enabled: root.active;
                clicked => { UiState.request-quit(); }
            }
        }
    }
}
