import { Slider, LineEdit, Palette } from "std-widgets.slint";
import { Icons, Icon, ToolButton } from "icons.slint";

// State has a distinct symbol as well as color. Details remain on hover.
export component StatusBadge inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> compact;
    // 0: inactive, 1: ready, 2: pending, 3: failed.
    in property <int> state;
    min-width: root.compact ? 32px : 44px;
    max-width: root.compact ? 32px : 44px;
    min-height: root.compact ? 32px : 44px;
    max-height: root.compact ? 32px : 44px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: text;
    accessible-label: root.label;
    Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: root.icon; opacity: root.state == 0 ? 0.45 : 1; }
    if root.state != 0 : Rectangle {
        x: parent.width - 18px; y: (parent.height - 20px) / 2 - 6px; width: 14px; height: 14px;
        background: Palette.background;
        border-radius: 7px;
        Icon {
            x: 1px; y: 1px; width: 12px; height: 12px;
            source: root.state == 1 ? Icons.check : root.state == 2 ? Icons.refresh : Icons.warning;
            colorize: root.state == 1 ? Palette.accent-background : Palette.foreground;
        }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}

export component ThemePicker inherits Rectangle {
    in-out property <int> current-index;
    in property <float> ui-scale: 1;
    in property <bool> enabled: true;
    out property <bool> has-focus: system.has-focus || light.has-focus || dark.has-focus;
    callback edited;
    min-height: max(44px, 20px * root.ui-scale + 20px);
    vertical-stretch: 0;
    forward-focus: system;
    HorizontalLayout {
        spacing: 8px;
        system := ToolButton { ui-scale: root.ui-scale; label: "システムに合わせる"; icon: Icons.desktop; enabled: root.enabled; accessible-checkable: true; checked: root.current-index == 0; clicked => { root.current-index = 0; root.edited(); } }
        light := ToolButton { ui-scale: root.ui-scale; label: "ライト"; icon: Icons.sun; enabled: root.enabled; accessible-checkable: true; checked: root.current-index == 1; clicked => { root.current-index = 1; root.edited(); } }
        dark := ToolButton { ui-scale: root.ui-scale; label: "ダーク"; icon: Icons.moon; enabled: root.enabled; accessible-checkable: true; checked: root.current-index == 2; clicked => { root.current-index = 2; root.edited(); } }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component SizeControl inherits Rectangle {
    in-out property <string> text <=> number.text;
    in property <float> ui-scale: 1;
    private property <length> control-height: max(44px, 20px * root.ui-scale + 20px);
    in property <bool> enabled: true;
    out property <bool> has-focus: number.has-focus || slider.has-focus;
    callback edited;
    min-height: root.control-height;
    vertical-stretch: 0;
    forward-focus: number;
    changed text => {
        if root.text.is-float() { slider.value = clamp(root.text.to-float(), 50, 200); }
    }
    HorizontalLayout {
        spacing: 8px;
        slider := Slider {
            enabled: root.enabled;
            minimum: 50; maximum: 200; step: 1;
            min-width: 44px;
            value: root.text.is-float() ? clamp(root.text.to-float(), 50, 200) : 100;
            accessible-label: "キャラクターの大きさ";
            changed => { root.text = "\{round(self.value)}"; root.edited(); }
        }
        number := LineEdit {
            enabled: root.enabled;
            input-type: InputType.number;
            accessible-label: "キャラクターの大きさ（%）";
            placeholder-text: "50〜200";
            min-width: 64px; max-width: 88px * root.ui-scale;
            min-height: root.control-height;
            max-height: root.control-height;
            edited => { root.edited(); }
        }
        Text { text: "%"; color: Palette.foreground; vertical-alignment: center; horizontal-stretch: 0; }
    }
}

export component MessageBubble inherits Rectangle {
    in property <string> author;
    in property <string> body;
    in property <bool> provisional;
    private property <bool> outgoing: root.author == "あなた";
    private property <string> author-label: root.author + (root.provisional ? " · デモの仮応答" : "");
    private property <brush> bubble-color: root.outgoing ? (Palette.color-scheme == ColorScheme.dark ? #285b40 : #c7efad) : Palette.control-background;
    private property <length> bubble-width: min(max(56px, measure.preferred-width + 28px), max(0px, min(root.width * 0.82, root.width - 48px)));
    min-height: content.min-height;
    vertical-stretch: 0;
    measure := Text { visible: false; text: root.body; }
    if !root.outgoing : Rectangle {
        x: 0px;
        y: 0px;
        width: 32px;
        height: 32px;
        background: Palette.alternate-background;
        border-radius: 16px;
        accessible-role: text;
        accessible-label: root.author-label;
        Icon { x: 4px; y: 4px; width: 24px; height: 24px; source: Icons.avatar; }
        if root.provisional : Icon { x: 22px; y: 22px; width: 12px; height: 12px; source: Icons.demo; }
        Tooltip { text: @markdown("\{root.author-label}"); }
    }
    bubble := Rectangle {
        x: root.outgoing ? parent.width - self.width - 8px : 40px;
        width: root.bubble-width;
        height: content.min-height;
        background: root.bubble-color;
        border-radius: 16px;
        accessible-role: text;
        accessible-label: root.author-label + ": " + root.body;
        Path {
            x: root.outgoing ? parent.width - 1px : -7px;
            y: 10px;
            width: 8px;
            height: 10px;
            commands: root.outgoing ? "M 0 0 L 8 0 L 0 10 Z" : "M 8 0 L 0 0 L 8 10 Z";
            fill: root.bubble-color;
        }
        content := VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 6px;
            Text { text: root.body; wrap: word-wrap; color: Palette.foreground; min-width: 0px; }
        }
    }
}
