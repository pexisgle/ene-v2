import { ChatEntry, ProviderField, SettingsDraft } from "types.slint";

export global UiState {
    in-out property <string> app-version;
    in-out property <bool> host-selection-visible: true;
    in-out property <bool> session-active;
    in-out property <int> page;
    in-out property <int> category;
    in-out property <string> font-family: "Noto Sans CJK JP";
    in-out property <[string]> font-families;
    in-out property <string> missing-font;
    in-out property <int> text-size: 16;
    in-out property <length> window-height: 760px;
    out property <float> scale: max(1, self.text-size / 16);
    out property <length> control-height: max(32px, 16px * self.scale + 12px);
    out property <length> settings-label-width: 144px * self.scale;
    out property <length> settings-field-gap: 12px;
    in-out property <bool> demo-mode;
    in-out property <bool> host-connected;
    in-out property <bool> chat-ready;
    in-out property <bool> send-pending;
    in-out property <bool> has-older;
    // 0 disconnected, 1 connecting/syncing, 2 connected, 3 retrying, 4 starting.
    in-out property <int> connection-phase;
    in-out property <string> connection-detail;
    in-out property <bool> connection-failed;
    in-out property <int> retry-seconds;
    // Independently observed even when the conversation is disconnected.
    in-out property <int> runtime-state;
    in-out property <string> runtime-endpoint;
    in-out property <string> runtime-detail;
    in-out property <bool> runtime-checking: true;
    in-out property <int> runtime-age;
    callback inspect-host;
    out property <bool> connection-pending: self.connection-phase == 1 || self.connection-phase == 4;
    out property <string> connection-label: self.host-connected ? "接続済み" : self.connection-phase == 1 ? "接続・同期中" : self.connection-phase == 3 ? "再接続待ち" : self.connection-failed ? "接続できません" : "未接続";
    out property <string> runtime-label: self.connection-phase == 4 ? "起動中" : self.runtime-state == 2 ? "稼働中" : self.runtime-state == 1 ? "停止中" : self.runtime-state == 3 ? "確認できません" : "確認中";
    in-out property <int> host-operation;
    callback host-draft-edited(int);
    in-out property <string> host-request-id;
    out property <bool> host-busy: self.host-operation != 0;
    in-out property <bool> connection-dirty;
    in-out property <bool> companion-dirty;
    in-out property <bool> permissions-dirty;
    out property <bool> host-dirty: self.connection-dirty || self.companion-dirty || self.permissions-dirty || self.credential-edit != 0;
    in-out property <string> setup-hint;
    in-out property <int> setup-category: 2;
    in-out property <bool> saved-model;
    callback reconnect-host;
    callback disconnect-host;
    in-out property <string> host-feedback;
    in-out property <bool> host-feedback-error;
    in-out property <int> host-save-category: -1;
    in-out property <bool> connection-configured;
    in-out property <string> selected-connection-id;
    in-out property <bool> connection-matches-provider;
    in-out property <int> credential-state;
    in-out property <string> conversation-error;
    in-out property <string> api-key;
    // 0 unchanged / typed key, 1 environment source, 2 revoke on Save.
    in-out property <int> credential-edit;
    in-out property <[string]> companion-names;
    in-out property <int> companion-index: -1;
    in-out property <string> selected-companion-id;
    in-out property <string> selected-companion-name;
    out property <bool> can-switch-companion: self.host-connected && !self.host-dirty && !self.host-busy && !self.send-pending && self.api-key == "" && self.credential-edit == 0;
    callback choose-companion(int);
    callback reset-host-drafts;
    callback reset-host-page;
    callback leave-demo;
    in-out property <string> companion-name;
    in-out property <string> companion-mind;
    // 0: unavailable, 1: loading, 2: ready, 3: failed.
    in-out property <int> availability-state;
    callback retry-availability;
    in-out property <bool> allow-conversation;
    in-out property <bool> allow-check;
    callback start-host;
    in-out property <[string]> provider-names;
    in-out property <int> provider-index: -1;
    in-out property <string> provider-id;
    in-out property <string> provider-name;
    in-out property <bool> provider-ready;
    in-out property <bool> provider-plugin;
    in-out property <string> provider-state;
    in-out property <string> provider-error;
    in-out property <string> provider-endpoint;
    in-out property <string> model-id;
    in-out property <[string]> model-ids;
    in-out property <[string]> model-choices;
    in-out property <int> model-choice-index: -1;
    in-out property <string> model-info;
    callback model-changed;
    in-out property <[ProviderField]> provider-fields;
    in-out property <string> environment-variable;
    in-out property <bool> requires-credentials;
    in-out property <bool> model-list-supported;
    in-out property <string> destinations;
    callback choose-provider(int);
    callback reload-providers;
    callback toggle-provider;
    callback fetch-models;
    callback configure-host;
    callback register-credential;
    callback environment-credential;
    callback revoke-credential;
    callback revoke-permissions;
    callback save-permissions;
    callback check-connection;
    callback save-companion;
    callback load-history;
    in-out property <[ChatEntry]> messages;
    in-out property <string> draft;
    in-out property <bool> can-send;
    in-out property <string> status;
    in-out property <SettingsDraft> settings-draft;
    in-out property <bool> settings-dirty;
    in-out property <string> apply-error;
    in-out property <string> error-field;
    in-out property <string> save-status;
    in-out property <bool> save-failed;
    in-out property <string> font-error;
    in-out property <string> size-error;
    in-out property <bool> picker-active;
    in-out property <bool> avatar-visible: true;
    in-out property <bool> avatar-ready;
    in-out property <bool> avatar-failed;
    in-out property <string> avatar-status;
    in-out property <bool> motion-playing;
    in-out property <bool> motion-loop;
    in-out property <bool> motion-configured;
    in-out property <string> motion-saved;
    callback set-motion-playing(bool);
    callback set-motion-loop(bool);
    in-out property <string> motion-status;
    in-out property <bool> motion-failed;
    in-out property <bool> tray-ready;
    in-out property <string> tray-status: "トレイを確認しています…";
    in-out property <bool> quit-confirmation;
    callback navigate(int);
    callback show-host-selection;
    callback start-demo;
    callback reveal-settings-item(length, length);
    callback settings-edited;
    callback save-settings;
    callback reset-settings;
    callback select-model;
    callback select-motion;
    callback draft-edited(string);
    callback submit;
    callback toggle-avatar;
    callback restart-avatar;
    callback recenter-avatar;
    callback request-quit;
    callback discard-and-quit;
    callback cancel-quit;
}
