import { IconData } from "../foundation/icons.slint";
import { Icon, Icons } from "../foundation/icons.slint";
import { Palette } from "std-widgets.slint";

export component StatusBadge inherits Rectangle {
    in property <IconData> icon;
    in property <string> label;
    in property <bool> compact;
    // 0: inactive, 1: ready, 2: pending, 3: failed.
    in property <int> state;
    min-width: 32px;
    max-width: 32px;
    min-height: root.compact ? 32px : 44px;
    max-height: root.compact ? 32px : 44px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: text;
    accessible-label: root.label;
    Icon { x: 4px; y: (parent.height - self.height) / 2; source: root.icon; opacity: root.state == 0 ? 0.45 : 1; }
    if root.state != 0 : Rectangle {
        x: 18px; y: (parent.height - 20px) / 2 - 6px; width: 14px; height: 14px;
        background: Palette.background;
        border-radius: 7px;
        Icon {
            x: 1px; y: 1px; width: 12px; height: 12px;
            source: root.state == 1 ? Icons.check : root.state == 2 ? Icons.refresh : Icons.warning;
            colorize: root.state == 1 ? Palette.accent-background : Palette.foreground;
        }
    }
    Tooltip { text: @markdown("\{root.label}"); }
}
