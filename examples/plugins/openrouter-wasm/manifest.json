{
  "contract_version": 3,
  "id": "openrouter-wasm",
  "name": "OpenRouter Wasm",
  "version": "1.0.0",
  "entrypoints": [
    {
      "id": "llm",
      "target": "host",
      "file": "provider.wasm",
      "provides": [
        "llm"
      ],
      "uses": [
        "http"
      ],
      "provider": {
        "id": "openrouter-wasm",
        "endpoint": "https://openrouter.ai/api/v1",
        "options": {
          "upstream": "openai",
          "allow_fallbacks": false
        },
        "settings": [
          {
            "key": "upstream",
            "label": "\u5b9f\u51e6\u7406\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc",
            "kind": "select",
            "required": true,
            "choices": [
              "openai"
            ]
          },
          {
            "key": "allow_fallbacks",
            "label": "\u30d5\u30a9\u30fc\u30eb\u30d0\u30c3\u30af",
            "kind": "boolean",
            "required": true
          }
        ],
        "auth": {
          "type": "bearer"
        },
        "environment_variable": "OPENROUTER_API_KEY",
        "destinations": [
          "https://openrouter.ai",
          "openai"
        ],
        "routing": {
          "type": "open_router",
          "only": [
            "openai"
          ]
        }
      }
    }
  ]
}
